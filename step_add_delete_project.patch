+async function deleteProjectRemote(id) {
+  const res = await fetch(`${SUPABASE_URL}/rest/v1/projects?id=eq.${id}`, {
+    method: "DELETE",
+    headers: sbHeaders,
+  });
+  if (!res.ok) throw new Error("프로젝트 삭제 실패");
+}
